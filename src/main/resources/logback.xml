<configuration>
  <conversionRule conversionWord="clr" converterClass="app.logging.LevelColorConverter" />

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %clr(%-5level) %logger{36} - %clr(%msg%n)</pattern>
    </encoder>
  </appender>

  <root level="DEBUG">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
